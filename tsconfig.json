{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ESNext", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true
  },
  "include": ["docs/.vitepress/**/*.mts", "docs/.vitepress/**/*.ts"],
  "exclude": ["docs/.vitepress/cache", "docs/.vitepress/dist"]
}
